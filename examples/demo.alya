## Example usage and walkthrough for linq
## Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "../src/lib.alya" as pkg

function is_odd(x)
    return x % 2 != 0
end

function square(x)
    return x * x
end

function get_category(item)
    return item[0]
end

function format_array(arr)
    let s = "["
    let n = len(arr)
    let i = 0
    while i < n
        if i > 0
            s += ", "
        end
        s = f"{s}{arr[i]}"
        i += 1
    end
    return s + "]"
end

function format_nested(arr)
    let s = "["
    let n = len(arr)
    let i = 0
    while i < n
        if i > 0
            s += ", "
        end
        s = f"{s}{format_array(arr[i])}"
        i += 1
    end
    return s + "]"
end

function main()
    say "=== linq Package Showcase ==="
    say ""

    # 1. Fluent Pipeline (range + where + map + take)
    say "--- 1. Fluent Query Pipeline ---"
    let squares = pkg::range(1, 10)
    .where(is_odd)
    .map(square)
    .take(4)
    .to_array()
    say f"First 4 odd squares: {format_array(squares)}"
    say ""

    # 2. Reshaping (chunk & window)
    say "--- 2. Reshaping (chunk & window) ---"
    let nums = [1, 2, 3, 4, 5, 6, 7]
    let chunks = pkg::query(nums).chunk(3).to_array()
    say f"Chunks of size 3: {format_nested(chunks)}"
    let windows = pkg::query(nums).window(3).to_array()
    say f"Sliding windows of size 3: {format_nested(windows)}"
    say ""

    # 3. Sorting & Deduplication
    say "--- 3. Sorting & Deduplication ---"
    let raw = [4, 1, 3, 2, 4, 1, 5]
    let unique_sorted = pkg::query(raw)
    .distinct()
    .order_by()
    .to_array()
    say f"Unique sorted: {format_array(unique_sorted)}"
    let sorted_desc = pkg::query(raw).order_by_desc().to_array()
    say f"Sorted descending: {format_array(sorted_desc)}"
    say ""

    # 4. Grouping
    say "--- 4. Grouping by Key ---"
    let products = [
        ["fruit", "apple"],
        ["dairy", "milk"],
        ["fruit", "banana"],
        ["dairy", "cheese"],
        ["bakery", "bread"]
    ]
    let grouped = pkg::query(products).group_by(get_category)
    for cat in keys(grouped)
        let items = grouped[cat]
        say f"  Category '{cat}': {len(items)} item(s)"
    end
    say ""

    # 5. Aggregations (sum, min, max, average)
    say "--- 5. Aggregations ---"
    let values = [10, 20, 30, 40, 50]
    let q = pkg::query(values)
    say f"Count:   {q.count()}"
    say f"Sum:     {q.sum()}"
    say f"Min:     {q.min()}"
    say f"Max:     {q.max()}"
    say f"Average: {q.average()}"
    say ""

    say "=== All linq demonstrations completed! ==="
end

main()
