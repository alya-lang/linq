## linq Library Facade
##
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).
## Serves as the primary public entry point for the linq package,
## providing fluent query pipelines, filtering, projection, grouping, and aggregation.

import "./types.alya"
import "./pipeline.alya"

# The `generators` slice gates the entry-point factories below
# (query/from_array/range/replicate); `make_enumerable` in
# `pipeline.alya` stays ungated as the cross-slice core constructor.

# ───────────────────────────────────────────────────────────────
# Primary Factory APIs
# ───────────────────────────────────────────────────────────────

## Initiates a fluent query pipeline from an existing array or collection.
##
## ### Parameters
## - `arr`: Source array of elements. Defaults to empty array.
##
## ### Returns
## An `Enumerable` pipeline instance ready for chaining operations.
##
## ### Examples
## ```alya
## let evens = query([1, 2, 3, 4]).where(fn(x) return x % 2 == 0 end).to_array()
## ```
##
## Requires the `generators` feature (default-on).
@cfg(feature = "generators")
pub function query(arr = []) -> Enumerable
    return make_enumerable(arr)
end

## Alias for `query`. Creates a query pipeline wrapping `arr`.
##
## ### Parameters
## - `arr`: Source array. Defaults to empty array.
##
## ### Returns
## An `Enumerable` instance.
##
## Requires the `generators` feature (default-on).
@cfg(feature = "generators")
pub function from_array(arr = []) -> Enumerable
    return make_enumerable(arr)
end

## Generates an Enumerable sequence of consecutive integers starting at `start`.
##
## ### Parameters
## - `start`: First integer in the sequence. Defaults to 0.
## - `count`: Number of sequential integers to generate. Defaults to 10.
##
## ### Returns
## An `Enumerable` with integers from `start` to `start + count - 1`.
##
## ### Examples
## ```alya
## let squares = range(1, 5).map(fn(x) return x * x end).to_array() # [1, 4, 9, 16, 25]
## ```
##
## Requires the `generators` feature (default-on).
@cfg(feature = "generators")
pub function range(start: int = 0, count: int = 10) -> Enumerable
    let res = []
    let i = 0
    while i < count
        res.push(start + i)
        i += 1
    end
    return make_enumerable(res)
end

## Generates an Enumerable sequence containing `count` copies of `val`.
##
## ### Parameters
## - `val`: Value to repeat.
## - `count`: Number of times to repeat. Defaults to 1.
##
## ### Returns
## An `Enumerable` holding `count` repeated values.
##
## ### Examples
## ```alya
## let items = replicate("A", 3).to_array() # ["A", "A", "A"]
## ```
##
## Requires the `generators` feature (default-on).
@cfg(feature = "generators")
pub function replicate(val, count: int = 1) -> Enumerable
    let res = []
    let i = 0
    while i < count
        res.push(val)
        i += 1
    end
    return make_enumerable(res)
end
